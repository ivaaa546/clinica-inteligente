# URL pública base de la API REST usada por Vite en desarrollo.
# No incluya secretos, cookies, contraseñas ni DATABASE_URL: cualquier VITE_* queda expuesta al navegador.
VITE_API_URL=http://localhost:3000/api/v1

# Zona IANA oficial de la clínica para presentar instantes de agenda.
VITE_CLINIC_TIMEZONE=America/Guatemala
