# Cadena de conexión a PostgreSQL para desarrollo local.
DATABASE_URL=postgresql://clinica:change-me@localhost:5432/clinica_inteligente

# Secreto de al menos 32 caracteres para firmar las cookies de sesión.
# Nunca subir el valor real al repositorio.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Puerto HTTP donde escucha la API.
PORT=3000

# Orígenes del frontend permitidos por CORS, separados por comas si hay varios.
CORS_ORIGINS=http://localhost:5173

# Entorno de ejecución: development, test o production.
NODE_ENV=development

# Parámetros de seguridad para los hashes Argon2id de contraseñas.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=1

# Zona horaria usada por la clínica para presentar fechas y horas.
CLINIC_TIMEZONE=America/Guatemala

# Credenciales de desarrollo usadas únicamente por el comando de seed.
# Sustituirlas antes de ejecutar el seed y nunca usar valores reales en este archivo.
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=replace-with-a-development-password
SEED_DOCTOR_EMAIL=doctor@example.test
SEED_DOCTOR_PASSWORD=replace-with-a-development-password
SEED_DOCTOR_PROFESSIONAL_NUMBER=DEV-001
SEED_SPECIALTY_NAME=Medicina General
