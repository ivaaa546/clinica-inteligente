# Base de datos PostgreSQL exclusiva para pruebas. Nunca usar la base de desarrollo o producción.
TEST_DATABASE_URL=postgresql://clinica:change-me@localhost:5432/clinica_inteligente_test

# Secreto de pruebas para firmar cookies de sesión; debe tener al menos 32 caracteres.
SESSION_SECRET=test-session-secret-with-at-least-32-chars

# Configuración de ejecución de la suite de pruebas.
NODE_ENV=test
PORT=3001
CORS_ORIGINS=http://localhost:5173

# Parámetros Argon2id reducidos para acelerar pruebas; no usar estos valores en producción.
ARGON2_TIME_COST=1
ARGON2_MEMORY_COST=16384
ARGON2_PARALLELISM=1

# Zona horaria de referencia para los flujos de prueba.
CLINIC_TIMEZONE=America/Tegucigalpa
